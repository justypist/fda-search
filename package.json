{
  "name": "fda-search",
  "version": "1.0.0",
  "description": "FDA 内容变更监听与全站正文检索: RSS + openFDA + sitemap + 正文库",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "collect": "node src/cli.ts collect",
    "collect:verbose": "node src/cli.ts collect --verbose",
    "collect:rss": "node src/cli.ts collect --stage rss",
    "collect:openfda": "node src/cli.ts collect --stage openfda",
    "collect:sitemap": "node src/cli.ts collect --stage sitemap",
    "collect:full": "node src/cli.ts collect --full",
    "content": "node src/cli.ts collect --stage content",
    "content:full": "node src/cli.ts collect --stage content --full",
    "status": "node src/cli.ts status",
    "alerts": "node src/cli.ts alerts",
    "tail": "node src/cli.ts tail",
    "search": "node src/cli.ts search",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "recall": "node src/cli.ts recall",
    "reset": "node src/cli.ts reset",
    "bulk": "node src/cli.ts bulk",
    "serve": "node src/cli.ts serve",
    "ocr:setup": "bash scripts/setup-ocr.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.95",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "@napi-rs/canvas": "0.1.80",
    "ai": "^7.0.142",
    "fast-xml-parser": "^5.11.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.10.38",
    "stream-json": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/stream-json": "^1.7.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
